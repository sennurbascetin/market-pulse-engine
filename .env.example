# ---------------------------------------------------------------------------
# Market Pulse Engine — configuration
# Copy to `.env` and edit. Every value below is optional: the engine runs with
# sensible defaults and zero credentials.
# ---------------------------------------------------------------------------

# --- Watchlist & cadence ---------------------------------------------------
MPE_WATCHLIST=AAPL,NVDA,TSLA,MSFT,SPY,BTC-USD,ETH-USD
MPE_POLL_SECONDS=60
# Run the (slower, paid) LLM stage once every N pipeline cycles.
MPE_LLM_EVERY_N_RUNS=5

# --- Storage ---------------------------------------------------------------
MPE_DB_PATH=data/market_pulse.duckdb
MPE_LOG_PATH=logs/pipeline.log

# --- Anomaly thresholds ----------------------------------------------------
MPE_ZSCORE_THRESHOLD=2.5
MPE_IQR_MULTIPLIER=1.5
# Minimum observations per ticker before statistics are trusted.
MPE_MIN_OBSERVATIONS=12

# --- Intelligence layer ----------------------------------------------------
# auto | openai | heuristic
#   auto      -> openai if OPENAI_API_KEY is set, else the offline heuristic
#                analyst (no network, no cost).
#   heuristic -> force the offline analyst even when a key is present.
MPE_LLM_PROVIDER=auto
MPE_OPENAI_MODEL=gpt-5-mini
MPE_LLM_MAX_ARTICLES=10

# OPENAI_API_KEY=sk-...

# --- Dashboard -------------------------------------------------------------
MPE_DASH_HOST=127.0.0.1
MPE_DASH_PORT=8050
MPE_DASH_REFRESH_SECONDS=60

# --- Demo mode -------------------------------------------------------------
# When true the engine replays synthetic/historical data so the dashboard looks
# live even with the markets closed. See DEMO_MODE.md.
MPE_DEMO_MODE=false
